{
  "name": "dcode-desktop",
  "productName": "DCode",
  "version": "0.1.0",
  "description": "The desktop client of the dcode daemon",
  "private": true,
  "license": "MIT",
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "gen:protocol": "cd .. && go run github.com/gzuidhof/tygo@v0.2.21 generate --config desktop/tygo.yaml",
    "check:protocol": "npm run gen:protocol && { git diff --exit-code -- src/protocol/generated.ts || { echo 'src/protocol/generated.ts is stale: run npm run gen:protocol and commit the result'; exit 1; }; }",
    "check:visual": "node tests/visual/check.mjs",
    "check:daemon": "node tests/daemon/check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
