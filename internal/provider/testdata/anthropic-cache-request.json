{
  "model": "claude-sonnet-4-5",
  "system": [
    {
      "type": "text",
      "text": "be brief",
      "cache_control": {
        "type": "ephemeral"
      }
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "read a.txt"
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "tool_use",
          "id": "c1",
          "name": "read",
          "input": {
            "path": "a.txt"
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "c1",
          "content": "hello",
          "cache_control": {
            "type": "ephemeral"
          }
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "read",
      "description": "read a file",
      "input_schema": {
        "type": "object"
      }
    },
    {
      "name": "write",
      "description": "write a file",
      "input_schema": {
        "type": "object"
      },
      "cache_control": {
        "type": "ephemeral"
      }
    }
  ],
  "stream": true,
  "max_tokens": 8192
}
